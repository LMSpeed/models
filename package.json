{
  "name": "lmspeed-models",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && pnpm typecheck && pnpm test",
    "build": "pnpm --filter @lmspeed/models build && pnpm --filter @lmspeed/models-site build",
    "validate": "tsx scripts/validate.ts",
    "sync": "tsx scripts/sync.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@iarna/toml": "2.2.5",
    "@playwright/test": "1.62.1",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "4.1.10",
    "quicktype-core": "26.0.0",
    "tsup": "9.0.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}

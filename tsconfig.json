{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@lmspeed/models-core": ["./packages/core/src/index.ts"],
      "@lmspeed/models-publish": ["./packages/publish/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "sdk/javascript/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/dist/**", "node_modules"]
}

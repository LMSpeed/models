{
  "name": "@lmspeed/models",
  "version": "0.1.0",
  "description": "Source-attributed model specifications, stable identity aliases and logos",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --no-splitting",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LMSpeed/models.git",
    "directory": "sdk/javascript"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}

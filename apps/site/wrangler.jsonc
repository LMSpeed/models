{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lmspeed-models",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "models.lmspeed.net",
      "custom_domain": true
    }
  ],
  "env": {
    "preview": {
      "name": "lmspeed-models-preview",
      "routes": [
        {
          "pattern": "models-preview.lmspeed.net",
          "custom_domain": true
        }
      ]
    }
  }
}
